{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ripe-atlas-mcp",
  "account_id": "47d71747660aab24284661867a77ed71",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/mcp"]
  }
}
